<UserControl x:Class="Mhodume.CrosshairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mhodume">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ PREVIEW ============================ -->
        <Grid Grid.Column="0" Margin="20,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="PREVIEW" Style="{StaticResource SectionHeaderFirst}"/>

            <Border Grid.Row="1" ClipToBounds="True"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <local:CrosshairPreview x:Name="Preview"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Zoom" Style="{StaticResource Label}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="ZoomSlider" Minimum="1" Maximum="8" Value="3"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="2" Width="26" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat={}{0:0}×}"/>

                <ComboBox Grid.Column="4" x:Name="BackdropBox" Width="100"
                          SelectionChanged="BackdropBox_SelectionChanged"/>
            </Grid>
        </Grid>

        <!-- =========================== SETTINGS ============================ -->
        <Border Grid.Column="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,8,16,16">
                <StackPanel>

                    <Label Content="SHAPE" Style="{StaticResource SectionHeaderFirst}"/>
                    <ComboBox x:Name="ShapeBox" SelectedValuePath="Key"
                              SelectedValue="{Binding Shape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Content="GEOMETRY" Style="{StaticResource SectionHeader}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Centre gap"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding Gap, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="40"
                            Value="{Binding Gap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Line length"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding Length, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="60"
                            Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thickness"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding Thickness, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="1" Maximum="12"
                            Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Centre dot"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding Dot, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="16"
                            Value="{Binding Dot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel x:Name="CirclePanel">
                        <Grid Margin="0,12,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Circle radius"
                                       Style="{StaticResource Label}" Margin="0,0,10,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Style="{StaticResource ValueField}">
                                <TextBlock Text="{Binding Radius, StringFormat={}{0:0} px}"
                                           Style="{StaticResource ValueText}"/>
                            </Border>
                        </Grid>
                        <Slider Minimum="2" Maximum="60"
                                Value="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <Label Content="COLOUR" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl x:Name="Swatches">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hex" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="HexBox"
                                 KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
                    </Grid>

                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Opacity"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0} %}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="10" Maximum="100"
                            Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="OUTLINE" Style="{StaticResource SectionHeader}"/>
                    <CheckBox Content="Black outline (readable on light scenes)"
                              IsChecked="{Binding Outline, Mode=TwoWay}"/>
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outline thickness"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding OutlineThickness, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="5"
                            Value="{Binding OutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="BEHAVIOUR" Style="{StaticResource SectionHeader}"/>
                    <CheckBox Content="Follow camera tilt" IsChecked="{Binding Tilt, Mode=TwoWay}"/>
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tilt strength"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding TiltFactor, StringFormat={}{0:0.00}×}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding TiltFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="POSITION" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Horizontal offset"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding OffsetX, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="-100" Maximum="100"
                            Value="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vertical offset"
                                   Style="{StaticResource Label}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock Text="{Binding OffsetY, StringFormat={}{0:0} px}"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider Minimum="-100" Maximum="100"
                            Value="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- The readout belongs with the crosshair: it is drawn on it,
                         and looking for it in its own section only invited
                         confusion with the game's own speedometer. -->
                    <local:SpeedPage x:Name="SpeedSection"/>

                    <Label Content="IN GAME" Style="{StaticResource SectionHeader}"/>
                    <CheckBox Content="Custom crosshair enabled" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                    <CheckBox Content="Hide the game's own crosshair" IsChecked="{Binding HideNative, Mode=TwoWay}"/>

                    <Border Height="16"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
