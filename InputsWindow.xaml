<Window x:Class="Mhodume.InputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mhodume"
        Title="Inputs" Height="420" Width="1000"
        MinHeight="320" MinWidth="640"
        Background="{StaticResource Bg}"
        Icon="assets/mhodume.ico"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================== TITLE BAR =========================== -->
        <Border Grid.Row="0" Background="{StaticResource Bg}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="INPUTS" FontSize="13" FontWeight="Bold"
                           FontFamily="{StaticResource Mono}"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                            ToolTip="Close">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" StrokeThickness="1.3"
                              Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= HEADER ============================ -->
        <Border Grid.Row="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="RunTitle" Text="—" FontFamily="{StaticResource Mono}"
                               FontSize="13"/>
                    <TextBlock x:Name="RunDetail" Text="" Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CAMERA" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="EyesRadio" Content="Their eyes" VerticalAlignment="Center"
                                 Margin="0,0,12,0" Checked="Eyes_Checked"/>
                    <RadioButton x:Name="BehindRadio" Content="Behind" VerticalAlignment="Center"
                                 Margin="0,0,20,0" Checked="Behind_Checked"/>
                    <Button x:Name="StopButton" Content="Stop" Margin="0,0,20,0"
                            VerticalAlignment="Center" Click="Stop_Click"/>
                    <TextBlock Text="ZOOM" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="Zoom" Width="140" Minimum="8" Maximum="600" Value="60"
                            VerticalAlignment="Center"
                            ValueChanged="Zoom_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ TIMELINE =========================== -->
        <ScrollViewer Grid.Row="2" x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="14,12,14,12">
            <local:InputTimeline x:Name="Timeline" HorizontalAlignment="Left"/>
        </ScrollViewer>

        <!-- ============================= READOUT =========================== -->
        <Border Grid.Row="3" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Two cells, because the left one changes on every mouse move
                     and would wipe the answer to "did my click do anything". -->
                <TextBlock Grid.Column="0" x:Name="Readout"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           Text="Point at the lanes to read a moment."/>
                <TextBlock Grid.Column="1" x:Name="WatchState"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{StaticResource Accent}" Text=""/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
