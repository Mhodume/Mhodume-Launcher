<Window x:Class="Mhodume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mhodume"
        Title="Mhodume" Height="720" Width="1100"
        MinHeight="600" MinWidth="940"
        Background="{StaticResource Bg}"
        Icon="assets/mhodume.ico"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False">

    <!-- The frame keeps doing the work; only the caption is ours. CaptionHeight
         is what makes the bar draggable and double-clickable, and the resize
         border is what keeps the edges grabbable now that the system one is
         gone. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Without the system frame the window has no outline of its own, and a
         near-black app on a dark desktop needs one to end somewhere. -->
    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========================== TITLE BAR =========================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Bg}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                MouseRightButtonUp="TitleBar_RightClick">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The wordmark, in the bar rather than under it: the system
                 caption already showed the mark and the name, and repeating
                 them a row later was the app arguing with the window. -->
            <Border Grid.Column="0" Background="{StaticResource Accent}"
                    Padding="13,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="assets/mhodume-64.png" Width="19" Height="19"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="MHODUME" FontSize="15" FontWeight="Bold"
                               FontFamily="{StaticResource Mono}"
                               Foreground="{StaticResource Bg}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- The current mode, and the one button that changes it. In the
                 bar so it is on every page: switching is the thing you reach
                 for from anywhere, not a setting buried under a tab. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="MODE" Foreground="{StaticResource Muted}"
                           FontFamily="{StaticResource Mono}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border x:Name="ModeChip" Background="{StaticResource Selected}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeChipText" Text="—"
                               Foreground="{StaticResource Accent}"
                               FontFamily="{StaticResource Mono}" FontSize="11"
                               FontWeight="Bold"/>
                </Border>
                <Button x:Name="SwitchModeButton" Click="SwitchMode_Click"
                        Margin="10,0,0,0" Padding="12,4" Content="SWITCH"
                        FontSize="11"/>
                <TextBlock x:Name="SwitchBusyText" Text="" Margin="10,0,0,0"
                           Foreground="{StaticResource Muted}"
                           FontFamily="{StaticResource Mono}" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="Minimise_Click"
                        ToolTip="Minimise">
                    <Rectangle Width="11" Height="1" Fill="{Binding Foreground,
                        RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                        Click="Maximise_Click" ToolTip="Maximise">
                    <Rectangle x:Name="MaximiseGlyph" Width="10" Height="10"
                               StrokeThickness="1" Stroke="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <!-- Hide, not close. Right-click the bar for the system menu
                     if you want it gone for good. -->
                <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                        ToolTip="Hide (the key brings it back)">
                    <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" StrokeThickness="1.3"
                          Stroke="{Binding Foreground,
                              RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- ========================== NAVIGATION =========================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,12,12">
                <Grid DockPanel.Dock="Top" Margin="1,0,1,14">
                    <TextBlock Text="MOD MENU" FontSize="11"
                               FontFamily="{StaticResource Mono}"
                               Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="VersionText" Text="v1.2" FontSize="11"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource Mono}"
                               Foreground="{StaticResource Muted}"/>
                </Grid>

                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Number}"
                                           FontFamily="{StaticResource Mono}" FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <!-- The accent, held back: a
                                                     label for the group, not a
                                                     destination competing with
                                                     the one you are on. -->
                                                <Setter Property="Foreground" Value="{StaticResource AccentDim}"/>
                                                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <!-- A group header is a label that happens to
                                     live in the list, so it takes neither the
                                     mouse nor the keyboard. -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Padding" Value="9,0,0,0"/>
                                    <Setter Property="Margin" Value="0,16,0,4"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================ PAGES ============================== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Which section this is, said once, where the eye lands first.
                 Every page used to repeat its own name below the name already
                 highlighted in the column; the room that frees goes to saying
                 what the page does. -->
            <Border Grid.Row="0" Padding="24,14,24,13"
                    BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PageNumber" Text=""
                               FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" x:Name="PageTitle" Text=""
                               FontFamily="{StaticResource Mono}" FontSize="18"
                               FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Beside the name rather than in a panel of its own: it
                         is a condition of the whole section, not a paragraph
                         to read once and scroll past. -->
                    <Border Grid.Column="2" x:Name="TrainingNeeded" Visibility="Collapsed"
                            Background="{StaticResource WarnFill}"
                            BorderBrush="{StaticResource Warn}" BorderThickness="1"
                            Padding="8,2" Margin="14,0,0,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            ToolTip="Press F7 in game. Without it these features do nothing, and any lap they touch stays uncountable until you restart the level.">
                        <TextBlock Text="NEEDS F7" FontFamily="{StaticResource Mono}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource WarnText}"/>
                    </Border>
                    <TextBlock Grid.Column="3" x:Name="PageNote" Text=""
                               FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <local:CrosshairPage  x:Name="PageCrosshair"/>
            <local:HudPage        x:Name="PageHud"        Visibility="Collapsed"/>
            <local:TrajectoryPage x:Name="PageTrajectory" Visibility="Collapsed"/>
            <local:MapsPage       x:Name="PageMaps"       Visibility="Collapsed"/>
            <local:CheckpointsPage x:Name="PageCheckpoints" Visibility="Collapsed"/>
            <local:TrainingPage   x:Name="PageTraining"   Visibility="Collapsed"/>
            <local:TweaksPage     x:Name="PageTweaks"     Visibility="Collapsed"/>
            <local:FreecamPage    x:Name="PageFreecam"    Visibility="Collapsed"/>
            <local:ProfilesPage   x:Name="PageProfiles"   Visibility="Collapsed"/>

            <!-- About is short enough to live inline -->
            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource Muted}" FontSize="12"
                               Text="This menu talks to a small module running inside VHOLUME through UE4SS. Settings are written to a config file that the game re-reads three times a second, so changes appear while you play — no restart, no alt-tab, and no key to press. Which key does what is the exception: the mod claims its keys when the game starts and cannot change them afterwards."/>

                    <Label Content="THIS WINDOW" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Solid" Style="{StaticResource Label}"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource ValueField}">
                            <TextBlock x:Name="OpacityValue" Text="92 %"
                                       Style="{StaticResource ValueText}"/>
                        </Border>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="92"
                            ValueChanged="Opacity_Changed"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                               Margin="0,6,0,0" LineHeight="17"
                               Text="How much of the game shows through. The whole window dims together, the text with it, so there is a point past which this is pretty rather than usable — around seventy is where reading starts to cost effort."/>

                    <Label Content="IN-GAME KEYS" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="F6" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Ask the engine what it is answering, and start the error counts clean"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="F10" Foreground="{StaticResource Accent}" FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="The game's own debug console (not part of this mod)"/>
                    </Grid>

                    <Label Content="FILES" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource Muted}" FontFamily="Consolas"/>
                    <Button Content="Open config folder" Margin="0,12,0,0"
                            HorizontalAlignment="Left" Click="OpenConfigFolder_Click"/>

                    <Label Content="MOD ON / OFF" Style="{StaticResource SectionHeader}"/>
                    <Border Padding="14,12"
                            Background="{StaticResource PanelAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="LoaderState" Text="Checking…"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                       FontSize="11" Margin="0,6,0,0" LineHeight="17"
                                       Text="VHOLUME refuses to validate runs while the mod loader is present — it detects the injection itself, whatever the mod does. So switch it off when you want your times to count, and back on to practise. Close the game before switching."/>
                            <Button x:Name="LoaderButton" Content="Loading…" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Padding="16,7"
                                    Click="ToggleLoader_Click"/>
                        </StackPanel>
                    </Border>

                    <Label Content="INSTALL" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="ModStatusText" TextWrapping="Wrap" FontSize="12"/>

                    <Label Content="NOTE" Style="{StaticResource SectionHeader}"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource Muted}" FontSize="12"
                               Text="Nothing in the game's own files is modified. To remove everything, delete dwmapi.dll and the ue4ss folder from VHOLUME/Binaries/Win64."/>
                    <Border Height="16"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================== STATUS BAR =========================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Is anything getting through to the game. LIVE is lit only
                     when the game is up and the loader is on; otherwise your
                     changes are sitting on disk waiting for it. -->
                <Border Grid.Column="0" Padding="14,9"
                        BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0"
                        ToolTip="The game re-reads your settings three times a second while it is running">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="StatusDot" Width="8" Height="8"
                                   Fill="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="LiveBadge" Text="LIVE"
                                   FontFamily="{StaticResource Mono}" FontSize="11"
                                   FontWeight="Bold" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1" x:Name="StatusText" Text="settings loaded"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,14,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Where you are and whether it counts -->
                <Border Grid.Column="2" Padding="14,9"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0">
                    <TextBlock x:Name="GameStatus" Text=""
                               Foreground="{StaticResource Muted}" FontSize="12"
                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="3" x:Name="TrainingBadge" Visibility="Collapsed"
                        Background="{StaticResource Warn}" Padding="14,9"
                        ToolTip="Training mode is on in game, so this lap will not count">
                    <TextBlock Text="TRAINING ON" FontFamily="{StaticResource Mono}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Bg}" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="4" Padding="14,9"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0">
                    <TextBlock x:Name="ProfileStatus" Text=""
                               Foreground="{StaticResource Muted}" FontSize="12"
                               FontFamily="{StaticResource Mono}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
