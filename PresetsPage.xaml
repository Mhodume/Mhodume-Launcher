<UserControl x:Class="Mhodume.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,16,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                   FontSize="12" LineHeight="18"
                   Text="A preset is a practice layout saved under a name: a map, the checkpoints you dropped on it, and your times against them. Save the checkpoints you have now, or pick one to train — its checkpoints go back in place and its times pick up where they were."/>

        <!-- Save the current layout -->
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,12"
                Background="{StaticResource PanelAlt}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="SAVE THE CHECKPOINTS YOU HAVE NOW"
                           Style="{StaticResource Label}"/>
                <TextBlock x:Name="CurrentMapText" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           Text="No map — start a level in game first."/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="NameBox"
                             VerticalContentAlignment="Center" Padding="8,0" Height="30"/>
                    <Button Grid.Column="1" x:Name="SaveButton" Content="Save preset"
                            Margin="8,0,0,0" Padding="14,6" Click="Save_Click"
                            IsEnabled="False"/>
                </Grid>
                <TextBlock x:Name="SaveNote" Margin="0,8,0,0" FontSize="11"
                           Foreground="{StaticResource Accent}" Text=""/>
            </StackPanel>
        </Border>

        <!-- The presets, and the one selected -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6">
                <ListBox x:Name="PresetList" HorizontalContentAlignment="Stretch"
                         BorderThickness="0" Background="Transparent"
                         SelectionChanged="PresetList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}"
                                           Text="{Binding Map, Converter={StaticResource MapName}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetail" Foreground="{StaticResource Muted}"
                               FontSize="12" VerticalAlignment="Top"
                               Text="Pick a preset to see its checkpoints and times."/>

                    <StackPanel x:Name="Detail" Visibility="Collapsed">
                        <TextBlock x:Name="DetailName" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailMap" FontSize="12"
                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Best complete run"
                                       Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="DetailGlobal"
                                       FontFamily="{StaticResource Mono}" FontSize="17"
                                       Foreground="{StaticResource Accent}"/>
                        </Grid>

                        <TextBlock Text="SECTIONS" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                        <ItemsControl x:Name="Sections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontSize="12.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BestText}"
                                                   FontFamily="{StaticResource Mono}" FontSize="12.5"
                                                   Foreground="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="TrainButton" Content="Train this preset"
                                    Padding="16,7" Click="Train_Click"/>
                            <Button x:Name="DeleteButton" Content="Delete" Margin="8,0,0,0"
                                    Padding="14,7" Click="Delete_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TrainNote" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource Accent}" Text=""/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
