<Window x:Class="Mhodume.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mhodume"
        Title="Mhodume" Height="560" Width="720"
        MinHeight="520" MinWidth="640"
        Background="{StaticResource Bg}"
        Icon="assets/mhodume.ico"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================== TITLE BAR =========================== -->
        <Border Grid.Row="0" Background="{StaticResource Bg}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Accent}" Padding="13,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="assets/mhodume-64.png" Width="19" Height="19"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="MHODUME" FontSize="15" FontWeight="Bold"
                                   FontFamily="{StaticResource Mono}"
                                   Foreground="{StaticResource Bg}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="1" Text="LAUNCHER" FontSize="11"
                           FontFamily="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimise_Click"
                            ToolTip="Minimise">
                        <Rectangle Width="11" Height="1" Fill="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click"
                            ToolTip="Close">
                        <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" StrokeThickness="1.3"
                              Stroke="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== BODY ============================= -->
        <Grid Grid.Row="1" Margin="24,22,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                       FontSize="12.5" LineHeight="19"
                       Text="Pick how to play. Training runs the game with the tools and the overlay; ranked runs it clean, so a time counts. Switching either way restarts the game for you."/>

            <!-- The two modes, side by side, each a slab you press. -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TRAINING -->
                <Button Grid.Column="0" x:Name="TrainingButton" Click="Training_Click"
                        Style="{StaticResource ModeCard}">
                    <StackPanel>
                        <TextBlock Text="TRAINING" FontFamily="{StaticResource Mono}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="the tools, the overlay, and free practice"
                                   Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"/>
                        <TextBlock Text="times are not submitted"
                                   Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Button>

                <!-- RANKED -->
                <Button Grid.Column="2" x:Name="RankedButton" Click="Ranked_Click"
                        Style="{StaticResource ModeCard}">
                    <StackPanel>
                        <TextBlock Text="RANKED" FontFamily="{StaticResource Mono}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="the plain game, nothing added"
                                   Foreground="{StaticResource Muted}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17"/>
                        <TextBlock Text="times count on the leaderboard"
                                   Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ============================= STATUS ============================ -->
        <Border Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center"
                           Text="Looking for VHOLUME…"/>
                <TextBlock Grid.Column="1" x:Name="ModeText"
                           FontFamily="{StaticResource Mono}" FontSize="12"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
