<UserControl x:Class="Mhodume.SpeedPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <Label Content="SPEED READOUT" Style="{StaticResource SectionHeader}"/>

        <Border Margin="0,0,0,0" Padding="14,12"
                Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <StackPanel>
                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                          FontSize="13" FontWeight="SemiBold" Content="Show speed on the crosshair"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                           Margin="24,4,0,0"
                           Text="Independent of the game's own speedometer, which stays under your control in the HUD section."/>
            </StackPanel>
        </Border>

        <StackPanel IsEnabled="{Binding Enabled}">

            <Label Content="POSITION" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Distance below the crosshair"
                           Style="{StaticResource Label}" Margin="0,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Style="{StaticResource ValueField}">
                    <TextBlock Text="{Binding OffsetY, StringFormat={}{0:0} px}"
                               Style="{StaticResource ValueText}"/>
                </Border>
            </Grid>
            <Slider Minimum="-200" Maximum="300"
                    Value="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Margin="0,12,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Horizontal offset"
                           Style="{StaticResource Label}" Margin="0,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Style="{StaticResource ValueField}">
                    <TextBlock Text="{Binding OffsetX, StringFormat={}{0:0} px}"
                               Style="{StaticResource ValueText}"/>
                </Border>
            </Grid>
            <Slider Minimum="-300" Maximum="300"
                    Value="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="APPEARANCE" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Size"
                           Style="{StaticResource Label}" Margin="0,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Style="{StaticResource ValueField}">
                    <TextBlock Text="{Binding Scale, StringFormat={}{0:0.0}×}"
                               Style="{StaticResource ValueText}"/>
                </Border>
            </Grid>
            <Slider Minimum="0.5" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Value="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Colour" Style="{StaticResource Label}" Margin="0,12,0,4"/>
            <ItemsControl x:Name="Swatches">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <CheckBox Content="Colour it by speed" Margin="0,12,0,0"
                      IsChecked="{Binding ColorBySpeed, Mode=TwoWay}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                       Margin="24,4,0,0" LineHeight="17"
                       Text="The readout runs blue when you are slow through to bright red at top speed, using the same scale as the trail. The colour above is ignored while this is on."/>

        <Label Content="SPEED SCALE" Style="{StaticResource SectionHeader}"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4">
                <Run Text="Top speed"/>
                <Run Text="{Binding TopSpeed, StringFormat={}{0} units}"
                     Foreground="{StaticResource Text}"/>
            </TextBlock>
            <Slider Minimum="500" Maximum="5000" TickFrequency="50" IsSnapToTickEnabled="True"
                    Value="{Binding TopSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                       Margin="0,6,0,0" LineHeight="17"
                       Text="Where the gradient turns bright red. 2600 is the speed runners chase, so that is the default. This applies to the trail as well, and takes effect straight away — no need to load the run again."/>

            <Label Content="FORMAT" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Decimal places"
                           Style="{StaticResource Label}" Margin="0,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Style="{StaticResource ValueField}">
                    <TextBlock Text="{Binding Decimals, StringFormat={}{0:0}}"
                               Style="{StaticResource ValueText}"/>
                </Border>
            </Grid>
            <Slider Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Decimals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Suffix" Style="{StaticResource Label}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding Suffix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                       Text="Appended after the number, for example &quot; u/s&quot;. Leave empty for just the figure."/>

            <CheckBox Content="Count vertical speed too" Margin="0,12,0,0"
                      IsChecked="{Binding IncludeFall, Mode=TwoWay}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                       Margin="24,4,0,0" LineHeight="17"
                       Text="Off by default: horizontal speed is what matters for movement, and including falling makes the figure jump around during drops."/>

        </StackPanel>

    </StackPanel>
</UserControl>
